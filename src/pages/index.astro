---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import Logo from "@/components/Logo.astro"
import { getPostUrl } from "@/content.config"
import Layout from "@/layouts/Layout.astro"
import { getImageUrl } from "@/lib/imagekit"
import { Icon } from "astro-icon/components"

export const prerender = true

const posts = await getCollection("posts")
const featuredPosts = posts
  .filter((post) => post.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const projects = (await getCollection("projects"))
  .map((project) => project.data)
  .sort((a, b) => b.stars - a.stars)

interface Props {
  lightbox?: boolean
}
const { lightbox } = Astro.props
---

<Layout page="home">
  <div class="flex flex-col gap-12">
    <section class="bg-dots flex flex-col items-center justify-center py-16 lg:py-44">
      <div class="mb-6 flex gap-3 lg:gap-5">
        {
          lightbox ? (
            <dialog
              id="lightbox"
              open
              aria-label="Profile image"
              class="fixed inset-0 z-20 m-0 flex h-screen max-h-none w-screen max-w-none cursor-default items-center justify-center overflow-hidden border-0 bg-black/75 p-10 text-inherit backdrop-blur"
            >
              <a href="/" class="absolute inset-0" aria-hidden="true" tabindex="-1" />
              <a
                href="/"
                aria-label="Close image"
                data-lightbox-close
                autofocus
                class="surface-button surface-button--icon absolute right-3 top-3 z-10"
              >
                <Icon name="x" />
              </a>
              <Logo w={1200} class="relative flex max-h-[90vh] max-w-[90vw] object-cover" />
            </dialog>
          ) : (
            <a
              href="/lightbox"
              data-motion-profile
              class="logo cursor-pointer transition-all hover:brightness-110 hover:contrast-125"
            >
              <Logo w={120} h={120} round />
            </a>
          )
        }
        <div class="flex flex-col">
          <div class="font-rubik text-sm text-neutral-11">@pablopunk</div>
          <h1 class="relative text-2xl font-bold lg:text-5xl">Pablo Varela</h1>
          <div>
            <h2
              class="bg-gradient-to-r from-accent-11 to-accent2-11 bg-clip-text text-2xl font-bold text-transparent lg:text-4xl"
            >
              Remote Developer
            </h2>
          </div>
          <div
            class="mt-2 flex flex-col items-start justify-start gap-1 text-sm lg:flex-row lg:items-center"
          >
            <div class="">
              Currently working at <a
                href="https://maze.co/"
                class="font-bold text-accent2-11 transition-colors hover:text-accent2-12">Maze</a
              >.
            </div>
            <div class="">
              Previously, <a
                href="https://cv.pablopunk.com"
                class="font-bold text-accent2-11 transition-colors hover:text-accent2-12"
                >somewhere else</a
              >.
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col md:flex-row w-fit gap-2 ">
        {
          [
            {
              name: "Twitter",
              href: "https://twitter.com/pablopunk",
              icon: "twitter",
            },
            {
              name: "Bluesky",
              href: "https://bsky.app/profile/pablopunk.com",
              icon: "bsky",
            },
            {
              name: "Instagram",
              href: "https://instagram.com/pablopunk",
              icon: "instagram",
            },
            {
              name: "Email",
              href: "mailto:pablo@pablopunk.com",
              icon: "mail",
            },
          ].map((social) => (
            <a
              href={social.href}
              class="surface-button surface-button--small"
            >
              <Icon name={social.icon} />
              <span>{social.name}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
  <section class="flex flex-col items-center justify-center gap-6 lg:flex-row lg:items-stretch">
    <div class="w-fit">
      <h2
        class="mb-4 bg-gradient-to-r from-accent-11 to-accent2-11 bg-clip-text text-2xl font-bold text-transparent"
      >
        Featured projects
      </h2>
      <div class="flex max-w-md flex-wrap justify-center gap-4">
        {
          projects.map((project) => (
            <a
              href={project.href}
              data-motion-project
              class="surface-card surface-card--interactive relative flex w-full max-w-md items-start gap-2 p-2"
            >
              <Image
                src={project.image}
                alt={project.name}
                width={16}
                height={16}
                class="rounded-md"
                loading="eager"
              />
              <div>
                <h3 class="font-rubik text-sm font-bold">{project.name}</h3>
                <p class="max-w-md text-pretty text-xs font-normal text-neutral-11">
                  {project.description}
                </p>
              </div>
              <div class="absolute right-2 top-2 flex items-center gap-2 align-middle text-xs text-neutral-10">
                <span>{project.tag}</span>
                <Icon name={project.icon} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
    <div
      class="surface-card surface-card--tinted blob relative flex flex-col items-center justify-center gap-4 p-6"
    >
      <h3
        class="w-fit bg-gradient-to-r from-red-700 to-red-400 bg-clip-text text-2xl font-bold text-transparent dark:from-red-500 dark:to-red-300"
      >
        🩵 Open Source
      </h3>
      <p class="text-md max-w-md text-pretty font-rubik text-lg">
        <span class="text-accent-11">Everything I do is open-source</span>. Feel free to check out
        my projects, open issues, or contribute to them.
      </p>
      <p class="text-md max-w-md text-pretty font-rubik text-lg">
        I also made several <span class="text-accent-11">contributions to others</span>, you can see
        some of them on my GitHub profile.
      </p>
      <a
        href="https://github.com/pablopunk"
        class="z-10 surface-button surface-button--primary px-6 text-lg"
      >
        <Icon name="github" />
        <span>Open GitHub</span>
      </a>
    </div>
  </section>
  <section class="mt-12 flex flex-col items-center justify-center gap-5">
    <h2 class="text-3xl font-bold">Featured posts</h2>
    <div class="flex flex-col gap-3 lg:flex-row">
      {
        featuredPosts.map((post) => (
          <a
            href={getPostUrl(post)}
            class="surface-card surface-card--interactive group flex w-full flex-col items-center gap-4 p-4 lg:w-1/3"
          >
            <Image
              src={getImageUrl(post.data.image.url, { h: 240, q: 80 })}
              alt={post.data.title}
              class:list={[
                "h-[240px] w-full rounded-lg object-cover",
                { "dark:hidden": post.data.image.url_dark },
              ]}
              inferSize
              loading="eager"
            />
            {post.data.image.url_dark && (
              <Image
                src={getImageUrl(post.data.image.url_dark, { h: 240, q: 80 })}
                alt={post.data.title}
                class="hidden h-[240px] w-full rounded-lg object-cover dark:block"
                inferSize
                loading="eager"
              />
            )}
            <h3 class="font-rubik text-xl font-bold">{post.data.title}</h3>
            <p class="text-sm">{post.data.description}</p>
          </a>
        ))
      }
    </div>
    <div class="mt-4">
      <a
        href="/blog"
        class="surface-button surface-button--primary px-6 text-lg"
      >
        <Icon name="blog" />
        <span>See all posts</span>
      </a>
    </div>
  </section>

  <style>
    [data-motion-project] {
      transform-origin: center;
      backface-visibility: hidden;
      will-change: transform;
    }

    .bg-dots {
      position: relative;
    }
    .bg-dots::before {
      z-index: -1;
      content: "";
      position: absolute;
      left: 0;
      inset: 0;
      height: 100%;
      width: 100%;
      background-image: radial-gradient(var(--accent-5) 1px, transparent 1px);
      -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 60%, transparent 100%);
      mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 60%, transparent 100%);
      background-size: 18px 18px;
    }
    .blob {
      overflow: hidden;
    }

    .blob::before,
    .blob::after {
      transition:
        width 0.4s,
        height 0.4s,
        filter 0.4s;
    }

    :global(.dark) {
      .blob:hover::before,
      .blob:hover::after {
        width: 15rem;
        height: 15rem;
        filter: blur(80px);
      }
    }

    :global(.light) {
      .blob:hover::before,
      .blob:hover::after {
        width: 2rem;
        height: 2rem;
      }
    }
    .blob::before {
      content: "";
      position: absolute;
      top: 0;
      inset-inline-end: 0;
      width: 6.25rem;
      height: 6.25rem;
      background: var(--accent-9);
      border-radius: 100%;
      filter: blur(70px);
      opacity: 0.33;
    }
    .blob::after {
      content: "";
      position: absolute;
      bottom: 2rem;
      left: 2rem;
      inset-inline-end: 0;
      width: 100px;
      height: 100px;
      background: var(--accent-9);
      border-radius: 100%;
      filter: blur(60px);
      opacity: 0.33;
    }
    /* } */
  </style>
</Layout>

<script>
  import { animate, stagger } from "motion"

  const reveal = () => {
    const cards = document.querySelectorAll<HTMLElement>("[data-motion-project]")
    if (!cards.length) return

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    if (prefersReduced) return

    animate(
      cards,
      {
        transform: [
          "perspective(1000px) rotateX(-8deg) scale(0.985)",
          "perspective(1000px) rotateX(0deg) scale(1)",
        ],
      },
      {
        duration: 0.42,
        delay: stagger(0.05),
        ease: [0.22, 1, 0.36, 1],
      },
    )
  }

  document.addEventListener("astro:page-load", reveal)
</script>
