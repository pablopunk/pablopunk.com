---
interface Props {
  tags: string[]
  selected?: string
  left?: boolean
}

const { tags, selected, left } = Astro.props
---

<ul
  class:list={[
    "mb-5 mt-3 flex flex-wrap items-center gap-2",
    {
      "justify-center px-6": !left,
      "justify-start": left,
    },
  ]}
>
  {
    tags.map((_tag) => {
      const current = _tag === selected
      return (
        <li>
          <a
            data-motion-tag
            data-motion-tag-selected={current ? "true" : undefined}
            class="surface-tag text-sm"
            aria-current={current ? "page" : undefined}
            href={current ? "/blog" : `/tags/${_tag}`}
          >
            #{_tag}
          </a>
        </li>
      )
    })
  }
</ul>

<script>
  import { animate, stagger } from "motion"

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)")
  let tagEntrance: ReturnType<typeof animate> | undefined
  let selectedAnimation: ReturnType<typeof animate> | undefined

  const stopAnimations = () => {
    tagEntrance?.stop()
    selectedAnimation?.stop()
    tagEntrance = undefined
    selectedAnimation = undefined
  }

  const animateTagEntrance = () => {
    const tags = document.querySelectorAll<HTMLElement>("[data-motion-tag]")
    if (!tags.length) return

    tagEntrance?.stop()
    tagEntrance = undefined
    if (reducedMotion.matches) return

    tagEntrance = animate(
      tags,
      {
        opacity: [0, 1],
        transform: ["translateY(6px)", "translateY(0)"],
      },
      {
        duration: 0.18,
        delay: stagger(0.025),
        ease: [0.22, 1, 0.36, 1],
      },
    )
  }

  const animateSelectedTag = () => {
    const selectedTag = document.querySelector<HTMLElement>("[data-motion-tag-selected='true']")
    if (!selectedTag || reducedMotion.matches) return

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        selectedAnimation?.stop()
        selectedAnimation = animate(
          selectedTag,
          {
            scale: [1, 1.06, 1],
            boxShadow: [
              "0 0 0 0 rgba(59, 130, 246, 0)",
              "0 0 0 6px rgba(59, 130, 246, 0.18)",
              "0 0 0 0 rgba(59, 130, 246, 0)",
            ],
          },
          {
            duration: 0.55,
            ease: [0.22, 1, 0.36, 1],
          },
        )
      })
    })
  }

  reducedMotion.addEventListener("change", (event) => {
    if (!event.matches) return

    stopAnimations()
    document.querySelectorAll<HTMLElement>("[data-motion-tag]").forEach((tag) => {
      tag.style.opacity = "1"
      tag.style.transform = "none"
      tag.style.removeProperty("scale")
      tag.style.removeProperty("box-shadow")
    })
  })

  document.addEventListener("astro:before-swap", stopAnimations)
  document.addEventListener("astro:page-load", animateTagEntrance)
  document.addEventListener("astro:after-swap", animateSelectedTag)
</script>
