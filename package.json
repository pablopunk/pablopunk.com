{
	"name": "pablopunk.com",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24"
	},
	"packageManager": "pnpm@11.23.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check && tsc --noEmit",
		"test": "playwright test",
		"lint": "biome check src tests playwright.config.ts",
		"format": "biome check --write src",
		"type:check": "tsc --noEmit",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/tailwind": "6.0.2",
		"@astrojs/vercel": "11.0.16",
		"@fontsource-variable/lexend": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@fontsource-variable/rubik": "^5.3.0",
		"@radix-ui/colors": "^3.0.0",
		"@vercel/speed-insights": "^1.0.10",
		"astro": "7.4.2",
		"astro-icon": "^1.2.0",
		"astro-seo": "^1.2.0",
		"motion": "^12.38.0",
		"tailwindcss": "^3.4.3",
		"typescript": "^5.4.5"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.2"
	}
}
